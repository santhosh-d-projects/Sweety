# Sweety environment variables
# Copy to server/.env and fill in real values. No real secrets here.

# Port the API listens on
PORT=5000
# Frontend origin allowed by CORS (Vite dev server)
CLIENT_URL=http://localhost:5173

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sweety
DB_USER=sweety
DB_PASSWORD=choose-a-strong-password

# Secret used to sign JWTs (long random string)
JWT_SECRET=choose-a-long-random-secret

# --- Client (Vite) ---
# Base URL of the API, used by the React app
VITE_API_URL=http://localhost:5000
