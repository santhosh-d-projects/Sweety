# Sweety server environment variables
# Copy to server/.env and fill in real values. No real secrets here.
# This is the single source of truth for server variables (see README).

# Port the API listens on
PORT=5000
# Frontend origin allowed by CORS (Vite dev server)
CLIENT_URL=http://localhost:5173

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sweety
DB_USER=sweety
DB_PASSWORD=your-db-password

# Secret used to sign JWTs (long random string). Required — the server
# refuses to start without it.
JWT_SECRET=your-long-random-jwt-secret
# How long login tokens last (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Test database (used by `npm test` only). Defaults to the sweety_test
# database on the same host when unset.
TEST_DATABASE_URL=postgres://sweety:your-db-password@localhost:5432/sweety_test
