# Sweety server environment variables
# Copy to server/.env and fill in real values. No real secrets here.
# (Root .env.example lists the same variables for the whole project.)

# Port the API listens on
PORT=5000
# Frontend origin allowed by CORS (Vite dev server)
CLIENT_URL=http://localhost:5173

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sweety
DB_USER=sweety
DB_PASSWORD=<redacted>

# Secret used to sign JWTs (long random string)
JWT_SECRET=<redacted>
